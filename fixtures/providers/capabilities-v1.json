{
  "schemaVersion": "1",
  "architecture": "single-codex-coordinator",
  "coordinator": {
    "id": "codex-main",
    "soleWriter": true,
    "soleCompletionAuthority": true
  },
  "runtime": {
    "nativeAgentsEnabled": false,
    "multiAgentEnabled": false
  },
  "gates": {
    "core": {
      "status": "passed"
    },
    "native": {
      "status": "blocked"
    },
    "write": {
      "status": "blocked"
    }
  },
  "limits": {
    "maxPromptBytes": 4096,
    "maxTimeoutMilliseconds": 120000,
    "maxStdoutBytes": 65536,
    "maxStderrBytes": 65536,
    "externalWriterCount": 0
  },
  "recursiveDelegation": {
    "allowed": false
  },
  "outputContracts": {
    "pi-live-probe-output-v1": {
      "type": "object",
      "required": {
        "schemaVersion": "string",
        "profile": "string",
        "provider": "string",
        "model": "string",
        "probe": "string",
        "ok": "boolean"
      },
      "additionalProperties": false
    },
    "pi-candidate-output-v1": {
      "type": "object",
      "required": {
        "schemaVersion": "string",
        "profile": "string",
        "provider": "string",
        "model": "string",
        "activity": "string",
        "disposition": "string",
        "completionAuthority": "string",
        "summary": "string",
        "findings": "array",
        "suggestedChecks": "array"
      },
      "additionalProperties": false
    },
    "live-probe-output-v1": {
      "type": "object",
      "required": {
        "schemaVersion": "string",
        "provider": "string",
        "probe": "string",
        "ok": "boolean",
        "source": "string"
      },
      "additionalProperties": false
    },
    "agy-live-probe-output-v1": {
      "type": "object",
      "required": {
        "schemaVersion": "string",
        "provider": "string",
        "probe": "string",
        "ok": "boolean",
        "source": "object",
        "verification": "object"
      },
      "additionalProperties": false
    }
  },
  "adapters": {
    "pi-glm-live-probe": {
      "kind": "leaf-adapter",
      "enabled": true,
      "qualification": "current",
      "gate": "core",
      "mode": "no-tools",
      "activities": [
        "provider-qualification"
      ],
      "outputContracts": [
        "pi-live-probe-output-v1"
      ],
      "writeAccess": false,
      "recursiveDelegation": false,
      "executor": {
        "command": "{node}",
        "args": [
          "{manifest_dir}/probe-adapter.mjs",
          "pi-glm",
          "{prompt}"
        ],
        "workingDirectory": {
          "policy": "isolated-empty"
        },
        "environmentAllowlist": [
          "PATH",
          "HOME",
          "TMPDIR",
          "LANG",
          "LC_ALL",
          "HTTPS_PROXY",
          "HTTP_PROXY",
          "ALL_PROXY",
          "NO_PROXY",
          "ZAI_CODING_CN_API_KEY"
        ]
      }
    },
    "pi-deepseek-live-probe": {
      "kind": "leaf-adapter",
      "enabled": true,
      "qualification": "current",
      "gate": "core",
      "mode": "no-tools",
      "activities": [
        "provider-qualification"
      ],
