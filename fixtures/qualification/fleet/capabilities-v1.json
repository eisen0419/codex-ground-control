{
  "schemaVersion": "1",
  "architecture": "single-codex-coordinator",
  "coordinator": {
    "id": "codex-main",
    "soleWriter": true,
    "soleCompletionAuthority": true
  },
  "runtime": {
    "nativeAgentsEnabled": false,
    "multiAgentEnabled": false
  },
  "gates": {
    "core": {
      "status": "passed"
    },
    "native": {
      "status": "blocked"
    },
    "write": {
      "status": "blocked"
    }
  },
  "limits": {
    "maxPromptBytes": 4096,
    "maxTimeoutMilliseconds": 2000,
    "maxStdoutBytes": 4096,
    "maxStderrBytes": 4096,
    "externalWriterCount": 0
  },
  "recursiveDelegation": {
    "allowed": false
  },
  "outputContracts": {
    "fixture-result-v1": {
      "type": "object",
      "required": {
        "ok": "boolean",
        "marker": "string",
        "prompt": "string",
        "secretPresent": "boolean",
        "workspaceMarkerPresent": "boolean"
      },
      "additionalProperties": false
    }
  },
  "adapters": {
    "fixture-raw": {
      "kind": "leaf-adapter",
      "enabled": true,
      "qualification": "current",
      "gate": "core",
      "mode": "no-tools",
      "activities": [
        "qualification"
      ],
      "outputContracts": [
        "fixture-result-v1"
      ],
      "writeAccess": false,
      "recursiveDelegation": false,
      "executor": {
        "command": "{node}",
        "args": [
          "{manifest_dir}/adapter.mjs",
          "raw",
          "{prompt}"
        ],
        "workingDirectory": {
          "policy": "isolated-empty"
        },
        "environmentAllowlist": []
      }
    },
    "fixture-fenced": {
      "kind": "leaf-adapter",
      "enabled": true,
