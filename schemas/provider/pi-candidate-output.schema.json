{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ground-control.invalid/schemas/provider/pi-candidate-output-v1.json",
  "title": "Ground Control Pi candidate evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "runtimeUsage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profile",
        "provider",
        "model",
        "activity",
        "disposition",
        "completionAuthority",
        "summary",
        "findings",
        "suggestedChecks"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "profile": {
          "enum": [
            "pi-glm",
            "pi-deepseek",
            "pi-minimax"
          ]
        },
        "provider": {
          "enum": [
            "zai-coding-cn",
            "deepseek",
            "minimax-cn"
          ]
        },
        "model": {
          "enum": [
            "glm-5.2",
            "deepseek-v4-pro",
            "MiniMax-M3"
          ]
        },
        "activity": {
          "enum": [
            "analysis",
            "exploration",
            "testing",
            "review"
          ]
        },
        "disposition": {
          "const": "candidate-evidence"
        },
        "completionAuthority": {
          "const": "codex-main"
        },
        "summary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestedChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtimeUsage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "status"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1"
            },
            "source": {
              "const": "pi-message-end"
            },
            "status": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "status",
            "inputTokens",
            "outputTokens",
            "cacheReadTokens",
            "cacheWriteTokens",
            "totalTokens",
            "cost"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1"
            },
            "source": {
              "const": "pi-message-end"
            },
            "status": {
              "const": "reported"
            },
            "inputTokens": {
              "type": "number",
              "minimum": 0
            },
            "outputTokens": {
              "type": "number",
              "minimum": 0
            },
            "cacheReadTokens": {
              "type": "number",
              "minimum": 0
            },
            "cacheWriteTokens": {
              "type": "number",
              "minimum": 0
            },
            "totalTokens": {
              "type": "number",
              "minimum": 0
            },
            "cost": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "output",
                "cacheRead",
                "cacheWrite",
                "total"
              ],
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0
                },
                "output": {
                  "type": "number",
                  "minimum": 0
                },
                "cacheRead": {
                  "type": "number",
                  "minimum": 0
                },
                "cacheWrite": {
                  "type": "number",
                  "minimum": 0
                },
                "total": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    }
  }
}
