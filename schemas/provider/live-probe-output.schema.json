{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ground-control.invalid/schemas/provider/live-probe-output-v1.json",
  "title": "Ground Control provider live probe output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "probe",
    "ok",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "provider": {
      "enum": [
        "pi",
        "agy",
        "grok"
      ]
    },
    "probe": {
      "const": "public-sources-v1"
    },
    "ok": {
      "const": true
    },
    "source": {
      "const": "https://www.iana.org/help/example-domains"
    }
  }
}
