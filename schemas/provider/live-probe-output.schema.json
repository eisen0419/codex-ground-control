{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ground-control.invalid/schemas/provider/live-probe-output-v1.json",
  "title": "Ground Control Pi live probe output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "provider",
    "model",
    "probe",
    "ok"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "profile": {
      "enum": [
        "pi-glm",
        "pi-deepseek",
        "pi-minimax"
      ]
    },
    "provider": {
      "enum": [
        "zai-coding-cn",
        "deepseek",
        "minimax-cn"
      ]
    },
    "model": {
      "enum": [
        "glm-5.2",
        "deepseek-v4-pro",
        "MiniMax-M3"
      ]
    },
    "probe": {
      "const": "public-sources-v1"
    },
    "ok": {
      "const": true
    }
  }
}
