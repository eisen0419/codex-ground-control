{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-ground-control.invalid/schemas/qualification/campaign-v1.json",
  "title": "Ground Control offline qualification campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaign",
    "mode",
    "description",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "campaign": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "mode": {
      "const": "offline"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "severity",
          "driver",
          "input",
          "expected",
          "nextAction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "driver": {
            "enum": [
              "uppercase",
              "fail-closed",
              "validator-audit",
              "fleet-runner",
              "fleet-policy"
            ]
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "boundary": {
                "type": "string"
              },
              "contract": {
                "type": "string"
              },
              "case": {
                "type": "string"
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "terminalState",
              "output",
              "reason"
            ],
            "properties": {
              "terminalState": {
                "enum": [
                  "passed",
                  "blocked"
                ]
              },
              "output": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "nextAction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
