        "id": "app-ownership",
        "label": "App ownership + one writer",
        "focus": ["app", "task", "skill", "mcp-app", "main", "checkout", "repository"],
        "note": "The App owns task and Worktree lifecycle; codex-main remains the only workspace writer and completion authority."
