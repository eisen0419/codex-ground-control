  "cards": [
    {
      "dot": "cyan",
      "title": "App ownership",
      "items": [
        "ChatGPT desktop app owns tasks, Local, Worktrees, Handoff, branches, and approvals",
        "Ground Control never creates, removes, moves, or hands off an App Worktree"
      ]
    },
    {
      "dot": "violet",
      "title": "One writer",
      "items": [
        "codex-main writes only the checkout selected for the current App task",
        "Provider leaves return candidate evidence and cannot declare completion"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stable identity + evidence",
      "items": [
        "Local, linked Worktrees, and Handoff share the Git common-storage identity",
        "The runtime verifies append-only evidence before any bounded live execution"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed gates",
      "items": [
        "Status is detected → authenticated → enabled → qualified → current → run-authorized",
        "AGY keyring stays provider-native; Grok auth is copied only into disposable GROK_HOME",
        "Native agents and external writers remain blocked"
      ]
    }
  ]
