      {
        "id": "intent-and-authorization",
        "label": "Intent + permissions",
        "focus": ["mcp-app", "intent", "gate", "blocked", "repository"],
        "note": "The intent binds repository identity, brief digest, qualification fingerprint, and expiry before Codex evaluates the app-only start."
      },
      {
        "id": "runtime-and-evidence",
        "label": "Runtime + evidence",
        "focus": ["runtime", "leaf-worker", "fleet", "runtime-profile", "auth-binding", "providers", "main"],
        "note": "The CLI stays behind the skill; the worker and FleetRunner emit bounded events, exact-or-unknown usage, and a receipt."
      }
    ]
