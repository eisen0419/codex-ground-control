  "cards": [
    {
      "dot": "cyan",
      "title": "Visible App status",
      "items": [
        "The same Codex task shows Ready, Working, Done, stage, duration, usage, and receipt",
        "The card is an MCP App surface, not a fake native child-agent thread"
      ]
    },
    {
      "dot": "violet",
      "title": "Intent + native permission",
      "items": [
        "LeafRunIntent v1 binds repository identity, brief digest, qualification fingerprint, and expiry",
        "Codex governs app-only dispatch; Ground Control adds no second permission prompt",
        "Retry returns one run identity; denial, expiry, mismatch, or drift starts no Provider"
      ]
    },
    {
      "dot": "emerald",
      "title": "Exact evidence",
      "items": [
        "LeafRunEvent v1 journals are append-only and omit prompt, credentials, raw output, and hidden reasoning",
        "RuntimeUsage v1 is exact from Pi message_end or unknown—never estimated"
      ]
    },
    {
      "dot": "rose",
      "title": "Authority stays bounded",
      "items": [
        "codex-main remains the only workspace writer and completion authority",
        "Provider auth stays provider-owned; native agents and external writers remain blocked"
      ]
    }
