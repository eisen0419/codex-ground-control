  "cards": [
    {
      "dot": "cyan",
      "title": "App 内可见状态",
      "items": [
        "同一个 Codex task 显示 Ready、Working、Done、阶段、耗时、用量和 receipt",
        "状态卡是 MCP App 交互面，不会冒充原生子 Agent task"
      ]
    },
    {
      "dot": "violet",
      "title": "Intent 与原生权限",
      "items": [
        "LeafRunIntent v1 绑定仓库身份、brief 摘要、资格指纹和过期时间",
        "Codex 决定是否分发仅 App 可见的调用；Ground Control 不再增加第二层权限弹窗",
        "重试只返回同一 run identity；拒绝、过期、不匹配或漂移时 Provider 启动数为零"
      ]
    },
    {
      "dot": "emerald",
      "title": "精确证据",
      "items": [
        "LeafRunEvent v1 journal 只追加，且不含 prompt、凭据、原始输出或隐藏推理",
        "RuntimeUsage v1 只取 Pi message_end 的精确值；缺失时为 unknown，绝不估算"
      ]
    },
    {
      "dot": "rose",
      "title": "权限始终受限",
      "items": [
        "codex-main 仍是唯一工作区写入者和完成裁决主体",
        "Provider 认证仍归 Provider 所有；原生 Agent 与外部写入者继续保持 blocked"
      ]
    }
  ]
