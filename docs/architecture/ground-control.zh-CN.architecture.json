{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Ground Control for Codex",
    "subtitle": "App-native LeafRun · Codex 原生权限 · 唯一 Codex 写入者",
    "output": "ground-control.zh-CN.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [1800, 900],
    "views": [
      {
        "id": "app-native-path",
        "label": "App 内可见的 Pi LeafRun",
        "focus": ["developer", "app", "task", "skill", "mcp-app", "intent", "gate", "leaf-worker", "fleet", "providers"],
        "note": "从 App 内的用户意图开始，经 Codex 原生权限策略分发进入受限执行，最终只返回候选证据。"
      },
      {
        "id": "app-ownership",
        "label": "App 所有权与唯一写入者",
        "focus": ["app", "task", "skill", "mcp-app", "main", "checkout", "repository"],
        "note": "task 与 Worktree 生命周期由 App 管理；codex-main 仍是唯一工作区写入者和完成裁决主体。"
      },
      {
        "id": "intent-and-authorization",
        "label": "Intent 与权限",
        "focus": ["mcp-app", "intent", "gate", "blocked", "repository"],
        "note": "每个 intent 会先绑定仓库身份、brief 摘要、资格指纹和过期时间，再由 Codex 判断是否分发仅 App 可见的启动调用。"
      },
      {
        "id": "runtime-and-evidence",
        "label": "运行时与证据",
        "focus": ["runtime", "leaf-worker", "fleet", "runtime-profile", "auth-binding", "providers", "main"],
        "note": "CLI 位于 skill 后面；worker 与 FleetRunner 记录受限事件、精确或 unknown 的用量和 evidence receipt。"
      }
    ]
  },
